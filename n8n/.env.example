# Copy to n8n/.env (gitignored). Generate secrets with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=
# Public base URL n8n advertises for webhooks (your tunnel URL when Convex runs in the cloud)
WEBHOOK_URL=http://localhost:5678/

# Must equal the Convex env var of the same name (Convex -> n8n)
N8N_WEBHOOK_SECRET=
# Must equal the Convex env var of the same name (n8n -> Convex)
AUTOMATION_API_SECRET=
# Convex HTTP actions URL, e.g. https://<deployment>.convex.site
CONVEX_SITE_URL=

# Optional real email delivery via Resend (also create a "Resend API" Header Auth credential in n8n)
LENDLOOP_EMAIL_ENABLED=false
LENDLOOP_EMAIL_FROM=LendLoop <notifications@example.com>
