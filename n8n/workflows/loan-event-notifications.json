    {
      "name": "Remember event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const MAX_REMEMBERED = 1000;\n\nconst message = $(\"Compose message\").first().json;\nconst channel = $input.first().json.channel ?? \"email\";\nconst staticData = $getWorkflowStaticData(\"global\");\nconst delivered = staticData.deliveredEventIds ?? [];\nstaticData.deliveredEventIds = [...delivered, message.eventId].slice(-MAX_REMEMBERED);\n\nreturn [{ json: { status: \"delivered\", eventId: message.eventId, channel } }];"
      },
      "id": "2a2df80a-49b5-1c77-736c-1af3bd94f4e6",
      "position": [
        1820,
