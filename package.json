{
  "name": "lendloop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:convex": "convex dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "n8n:build": "node n8n/build-workflows.mjs",
    "n8n:check": "node n8n/build-workflows.mjs && git diff --exit-code -- n8n/workflows",
    "n8n:up": "docker compose up -d",
    "n8n:import": "./n8n/import.sh",
    "seed": "convex run seed:demo",
    "test:e2e": "playwright test",
    "setup:clerk": "node --env-file=.env.local scripts/setup-clerk-dev.mjs",
    "tunnel": "node scripts/tunnel.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.48.0",
    "convex-helpers": "^0.1.134",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "convex-test": "^0.0.67",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20"
  }
}
