# Next.js (.env.local)
NEXT_PUBLIC_CONVEX_URL=https://<deployment>.convex.cloud
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Convex deployment env — set with `npx convex env set <NAME> <value>`, never in this file:
#   CLERK_JWT_ISSUER_DOMAIN      https://<your-app>.clerk.accounts.dev
#   N8N_LOAN_EVENTS_WEBHOOK_URL  https://<tunnel>/webhook/lendloop/loan-events
#   N8N_WEBHOOK_SECRET           shared secret: Convex -> n8n signatures
#   AUTOMATION_API_SECRET        shared secret: n8n -> Convex signatures
